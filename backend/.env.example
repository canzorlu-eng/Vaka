# =====================================================================================
# Vaka backend configuration. Copy to .env (never commit .env). Production/staging values
# are set as environment variables in Render, NOT in a file. Use SEPARATE keys per environment.
# =====================================================================================

# ---- runtime ----
APP_ENV=development                 # development | staging | production
PUBLIC_BASE_URL=http://localhost:8001   # the URL users open (https://... in staging/production)
CORS_ORIGINS=http://localhost:3000      # only needed when the React dev server runs on another origin
LOG_LEVEL=INFO
AUTO_MIGRATE=true                   # dev convenience; deployed envs run `alembic upgrade head` as a pre-deploy step

# ---- datastores ----
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/vaka
REDIS_URL=                          # e.g. redis://localhost:56379/0 (docker-compose.dev.yml). REQUIRED in production.
DB_POOL_MAX=10

# ---- auth (Google sign-in) ----
SECRET_KEY=                         # >= 32 random chars: python -c "import secrets; print(secrets.token_urlsafe(48))"
GOOGLE_CLIENT_ID=                   # Google Cloud Console -> APIs & Services -> Credentials -> OAuth client (Web)
GOOGLE_CLIENT_SECRET=
ADMIN_EMAILS=                       # comma-separated Google emails that get the admin role

# ---- AI providers (server-side only) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite  # priced model (see usage.py); measure quality/cost with scripts/cost_probe.py
GEMINI_MODEL_GENERATION=            # optional stronger model for AI case generation only (e.g. gemini-3.8-flash)
GEMINI_MODEL_SCORING=               # optional model for scoring/feedback only
GEMINI_THINKING_BUDGET=-1           # -1 = model default; 0 disables thinking (cheaper, faster); N = token budget
OPENAI_API_KEY=
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=coral

# ---- cost guard rails ----
USER_DAILY_COST_CAP_FREE_USD=0.05
USER_DAILY_COST_CAP_PRO_USD=1.50
USER_MONTHLY_COST_CAP_FREE_USD=0.15
USER_MONTHLY_COST_CAP_PRO_USD=4
MAX_MESSAGES_PER_SESSION=40
GLOBAL_DAILY_COST_ALERT_USD=20
ALERT_WEBHOOK_URL=                  # Slack/Discord-compatible webhook for alerts (optional but recommended)

# ---- limits ----
MAX_BODY_BYTES=32768
MAX_CHAT_CHARS=600
GLOBAL_IP_LIMIT_PER_MIN=300
LLM_MAX_CONCURRENCY=8
JOB_WORKERS=2

# ---- payments (iyzico) ----
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com   # production: https://api.iyzipay.com
IYZICO_MERCHANT_ID=                 # iyzico merchant panel -> Settings (needed for webhook signature)
IYZICO_WEBHOOK_SECRET=              # optional; defaults to the iyzico secret key
IYZICO_PLAN_MONTHLY_USD=            # created by: python scripts/iyzico_setup.py
IYZICO_PLAN_YEARLY_USD=
IYZICO_PLAN_MONTHLY_TRY=
IYZICO_PLAN_YEARLY_TRY=
PRICE_MONTHLY_USD=9
PRICE_YEARLY_USD=90
PRICE_MONTHLY_TRY=399               # PLACEHOLDER - set to the TRY amount you actually want to charge
PRICE_YEARLY_TRY=3990               # PLACEHOLDER
